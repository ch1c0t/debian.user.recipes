{
  "Basic": {
    "prefix": "ba",
    "body": "T1=$1 T2=$2 T0=$0"
  },
  "Placeholders": {
    "prefix": "pl",
    "body": "T1=${1:aa}\nT2=${2:<$1>}"
  },
  "Choices": {
    "prefix": "ch",
    "body": "T1=${1|a,b|} T2=${2|c,d|}"
  },
  "Variables": {
    "prefix": "va",
    "body": "Runtime: $VIMRUNTIME\n"
  },
  "Multiline CoffeeScript String": {
    "prefix": "multiline_coffee_string",
    "body": "\"\"\"\n$0\n\"\"\""
  }
}
